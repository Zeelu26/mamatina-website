# ── Auth ────────────────────────────────────────────────
# Required in production. Generate a long random string (32+ chars).
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ── Supabase (database + image storage) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ── Contact form email notifications (optional) ─────────
# If unset, the contact form still saves messages to the admin dashboard.
RESEND_API_KEY=your-resend-api-key
# Where inquiry emails are sent (the business owner's inbox):
CONTACT_RECEIVER_EMAIL=owner@example.com
# The "from" address. A free mailbox (gmail, etc.) is NOT accepted by
# Resend and will automatically fall back to onboarding@resend.dev.
# To send from your own domain, verify it in Resend and put it here.
CONTACT_FROM_EMAIL=onboarding@resend.dev
